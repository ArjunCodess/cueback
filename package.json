{
  "name": "cueback",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "pnpm run build && node scripts/start.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "pack:desktop": "pnpm run build && node scripts/package-desktop.mjs",
    "pack:win": "pnpm run build && node scripts/package-desktop.mjs",
    "test": "node --test",
    "test:desktop": "pnpm run build && node scripts/check-desktop.mjs"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
